# Backend (FastAPI)
DATABASE_URL=postgresql+asyncpg://caselab:caselab@localhost:5434/caselab
TEST_DATABASE_URL=postgresql+asyncpg://caselab:caselab@localhost:5434/caselab_test
CORS_ORIGINS=["http://localhost:3000"]
INTERNAL_API_KEY=local-dev-key
# Vertex AI (uses Application Default Credentials: `gcloud auth application-default login`)
GCP_PROJECT=
GEMINI_LOCATION=global
CLAUDE_REGION=global
# Optional direct-API fallbacks (synthetic data only)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Web (Next.js, server-side only)
API_BASE_URL=http://localhost:8000
API_PUBLIC_URL=http://localhost:8000
